PORT=
# Where the Next.js app runs (allowed to call this API)
CLIENT_URL=http://localhost:30004000
# From the Clerk dashboard (API keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# From the Neon Console: click Connect
# Pooled connection, used by the app (hostname has -pooler)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
# Direct connection, used for migrations (same hostname without -pooler)
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# File uploads (people attaching files when they fill in a form). Our own ImageKit account, from
# imagekit.io > Developer options. Leave empty to turn uploads off.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Encrypts the ImageKit keys that users connect. 32 random bytes as base64. To make one:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=
