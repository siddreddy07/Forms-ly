{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formly",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No keys or addresses live in this file. NEXT_PUBLIC_* values come from .env.production.local at build time, and
  // secrets are set with `npx wrangler secret put`. Anything set in the Cloudflare dashboard is kept on deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
