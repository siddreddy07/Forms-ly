{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formly",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Public settings only (they are also baked into the browser code at build time). Secrets such as
  // CLERK_SECRET_KEY are never listed here: set them with `npx wrangler secret put`.
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://forms-ly.onrender.com",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_YWRlcXVhdGUtZ29ibGluLTgxOC5jbGVyay5hY2NvdW50cy5kZXYk",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/dashboard",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/dashboard"
  },
  // Keep any other variables and secrets set in the Cloudflare dashboard when deploying from here.
  "keep_vars": true,
  "observability": { "enabled": true }
}
